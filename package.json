{
	"name": "sqwer",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"postinstall": "node scripts/font-fallback.mjs",
		"dev": "npm run dev -w web",
		"build": "npm run build -w web",
		"preview": "npm run preview -w web",
		"start": "node apps/web/scripts/start.js",
		"test": "vitest run",
		"test:e2e": "npm run test:e2e -w web",
		"check": "npm run check -w web"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"vitest": "^5.0.4"
	}
}

{
	"name": "sqwer",
	"version": "1.0.0-beta.6",
	"private": true,
	"license": "GPL-3.0-only",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=24.22.1"
	},
	"scripts": {
		"preinstall": "node scripts/check-node.mjs",
		"postinstall": "node scripts/font-fallback.mjs",
		"dev": "npm run dev -w web",
		"build": "npm run build -w web",
		"preview": "npm run preview -w web",
		"start": "node apps/web/scripts/start.js",
		"test": "vitest run",
		"test:e2e": "npm run test:e2e -w web",
		"check": "npm run check -w web",
		"release": "node scripts/release.mjs",
		"bits": "node scripts/bits.mjs"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"vitest": "^5.0.4"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": ">=0.25.0"
		}
	}
}
